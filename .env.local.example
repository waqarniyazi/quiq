# Copy to .env.local and fill in. Get these from the Shopify "Headless" sales channel:
#   Storefront API -> Public access token, and your store's *.myshopify.com domain.
# The Storefront public token is safe to expose client-side (read + checkout scoped).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_public_token
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-07
